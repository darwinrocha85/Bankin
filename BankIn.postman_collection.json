{
	"info": {
		"_postman_id": "bankin-python-collection",
		"name": "BankIn (Python)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000" },
		{ "key": "clientId", "value": "1" },
		{ "key": "managerId", "value": "" },
		{ "key": "cardId", "value": "" },
		{ "key": "transactionId", "value": "" }
	],
	"item": [
		{
			"name": "Clientes",
			"item": [
				{
					"name": "Crear cliente",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Darwin Rocha\",\n    \"username\": \"darwin\",\n    \"product_id\": 112790\n}" },
						"url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] }
					}
				},
				{
					"name": "Crear gerente",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Sebastian Jefe\",\n    \"username\": \"sebas\",\n    \"product_id\": 999,\n    \"role\": \"MANAGER\"\n}" },
						"url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] }
					}
				},
				{
					"name": "Listar clientes",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] } }
				},
				{
					"name": "Obtener cliente",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] } }
				},
				{
					"name": "Actualizar cliente",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Darwin Rocha\",\n    \"username\": \"darwin\",\n    \"product_id\": 112790\n}" },
						"url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
					}
				},
				{
					"name": "Eliminar cliente",
					"request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] } }
				}
			]
		},
		{
			"name": "Tarjetas",
			"item": [
				{
					"name": "Emitir tarjeta",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"client_id\": {{clientId}}\n}" },
						"url": { "raw": "{{baseUrl}}/cards", "host": ["{{baseUrl}}"], "path": ["cards"] }
					}
				},
				{
					"name": "Listar tarjetas",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cards", "host": ["{{baseUrl}}"], "path": ["cards"] } }
				},
				{
					"name": "Activar tarjeta",
					"request": { "method": "POST", "url": { "raw": "{{baseUrl}}/cards/{{cardId}}/activate", "host": ["{{baseUrl}}"], "path": ["cards", "{{cardId}}", "activate"] } }
				},
				{
					"name": "Cancelar tarjeta",
					"request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/cards/{{cardId}}", "host": ["{{baseUrl}}"], "path": ["cards", "{{cardId}}"] } }
				},
				{
					"name": "Fijar balance (manual)",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"balance\": 5000\n}" },
						"url": { "raw": "{{baseUrl}}/cards/{{cardId}}/balance", "host": ["{{baseUrl}}"], "path": ["cards", "{{cardId}}", "balance"] }
					}
				},
				{
					"name": "Consultar balance",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cards/{{cardId}}/balance", "host": ["{{baseUrl}}"], "path": ["cards", "{{cardId}}", "balance"] } }
				}
			]
		},
		{
			"name": "Transacciones",
			"item": [
				{
					"name": "Recargar saldo",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"card_id\": \"{{cardId}}\",\n    \"amount\": 500\n}" },
						"url": { "raw": "{{baseUrl}}/transactions/recharge", "host": ["{{baseUrl}}"], "path": ["transactions", "recharge"] }
					}
				},
				{
					"name": "Comprar",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"card_id\": \"{{cardId}}\",\n    \"amount\": 150\n}" },
						"url": { "raw": "{{baseUrl}}/transactions/purchase", "host": ["{{baseUrl}}"], "path": ["transactions", "purchase"] }
					}
				},
				{
					"name": "Anular transacción",
					"request": { "method": "POST", "url": { "raw": "{{baseUrl}}/transactions/{{transactionId}}/annul", "host": ["{{baseUrl}}"], "path": ["transactions", "{{transactionId}}", "annul"] } }
				},
				{
					"name": "Listar transacciones",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] } }
				},
				{
					"name": "Transacciones de una tarjeta",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/transactions/card/{{cardId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "card", "{{cardId}}"] } }
				}
			]
		},
		{
			"name": "Gerente",
			"item": [
				{
					"name": "Resumen del banco",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/manager/overview?manager_id={{managerId}}", "host": ["{{baseUrl}}"], "path": ["manager", "overview"], "query": [{ "key": "manager_id", "value": "{{managerId}}" }] } }
				},
				{
					"name": "Todos los clientes",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/manager/clients?manager_id={{managerId}}", "host": ["{{baseUrl}}"], "path": ["manager", "clients"], "query": [{ "key": "manager_id", "value": "{{managerId}}" }] } }
				},
				{
					"name": "Vista 360 de un cliente",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/manager/clients/{{clientId}}?manager_id={{managerId}}", "host": ["{{baseUrl}}"], "path": ["manager", "clients", "{{clientId}}"], "query": [{ "key": "manager_id", "value": "{{managerId}}" }] } }
				},
				{
					"name": "Todas las tarjetas",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/manager/cards?manager_id={{managerId}}", "host": ["{{baseUrl}}"], "path": ["manager", "cards"], "query": [{ "key": "manager_id", "value": "{{managerId}}" }] } }
				},
				{
					"name": "Todas las transacciones",
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/manager/transactions?manager_id={{managerId}}", "host": ["{{baseUrl}}"], "path": ["manager", "transactions"], "query": [{ "key": "manager_id", "value": "{{managerId}}" }] } }
				}
			]
		}
	]
}
