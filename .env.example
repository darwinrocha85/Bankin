# Copia este archivo a ".env" para configurar el backend en local.
# En Render, estas mismas variables se configuran desde su dashboard
# (Settings -> Environment), no hace falta un archivo .env ahí.

# "local" o "production". Solo informativo, se ve en GET /health.
ENVIRONMENT=local

# Orígenes adicionales para CORS, separados por coma (por ejemplo la URL
# de Firebase Hosting una vez desplegado el frontend). Los orígenes de
# desarrollo local (localhost:5173) ya están permitidos siempre, no hace
# falta agregarlos aquí.
# ALLOWED_ORIGINS=https://tu-proyecto.web.app,https://tu-proyecto.firebaseapp.com

# "true" para poblar la base con datos de prueba al arrancar si está
# vacía. Pensado para Render, donde el disco del plan gratuito es efímero.
# En local normalmente no hace falta (corre "python seed_data.py" a mano).
# AUTO_SEED=true

# Ruta del archivo SQLite. Por defecto "bankin.db" en el directorio actual.
# BANKIN_DB_PATH=bankin.db
